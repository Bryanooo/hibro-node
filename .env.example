HIBRO_DOCKER_PORT=17332
# The container is published on 127.0.0.1; do not expose port 7331 publicly.
HIBRO_NODE_ALLOW_REMOTE_ACCESS=true
HIBRO_NODE_ARTIFACT_UPLOAD_TIMEOUT_MS=300000
HIBRO_NODE_PROJECT_ROOT=/absolute/path/to/your/project
HIBRO_NODE_DATA_VOLUME=hibro-node-data
HIBRO_NODE_CONTAINER_NAME=hibro-node-local
# all, none, or a comma-separated subset: claude-code,codex,openclaw
HIBRO_BUNDLED_ENGINES=all
# Optional when the official Debian mirror is slow, for example http://mirrors.aliyun.com
HIBRO_DEBIAN_MIRROR=http://deb.debian.org
# Optional in restricted networks, for example https://registry.npmmirror.com
HIBRO_NPM_REGISTRY=https://registry.npmjs.org
HIBRO_CODEX_DIR=/absolute/path/to/.codex
ANTHROPIC_API_KEY=
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=
