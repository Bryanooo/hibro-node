{
  "name": "@hibro/node",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Hibro Node execution runtime",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --experimental-strip-types src/cli.ts serve",
    "dev": "node --experimental-strip-types --watch src/cli.ts serve",
    "doctor": "node --experimental-strip-types src/cli.ts doctor",
    "run": "node --experimental-strip-types src/cli.ts run",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "check": "node --experimental-strip-types scripts/check.ts",
    "typecheck": "tsc --noEmit",
    "validate": "npm run typecheck && npm run check && npm test",
    "smoke:claude": "node --experimental-strip-types scripts/real-claude-smoke.ts",
    "release:package": "bash scripts/package-release.sh"
  },
  "dependencies": {
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/ws": "^8.18.1",
    "typescript": "^7.0.2"
  }
}
